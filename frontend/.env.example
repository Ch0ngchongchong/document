# 딱 재고 환경변수 목록 (이름만 적는다. 값은 쓰지 않는다)
# 사용법: 이 파일을 복사해 .env를 만들고, 값은 각자 .env에만 넣는다. .env는 커밋하지 않는다(.gitignore).

# ---------------------------------------------
# 백엔드 (backend/app/db.py에서 읽음)
# ---------------------------------------------
# PostgreSQL 접속 주소. 형식: postgresql+psycopg://사용자:비밀번호@호스트:포트/DB이름
DATABASE_URL=

# ---------------------------------------------
# 아직 이름을 정하지 않은 것 (코드에서 쓰기 시작할 때 여기에 추가)
# ---------------------------------------------
# - OCR 서비스 키: 미정 (OCR 방식 미정)
# - LLM API 키: 미정 (LLM 제공사 미정)
# - 화면(frontend)이 부를 백엔드 주소: 미정 (Vite에서는 이름이 VITE_로 시작해야 하고, frontend/ 폴더의 .env에서 읽힘)
